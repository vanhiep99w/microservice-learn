    },
    {
      "type": "text", "id": "header_argument", "x": 105, "y": 175, "width": 2900, "height": 45,
      "text": "MỘT INGEST  →  ABR  →  CDN FAN-OUT;  COMMENTS VÀ MONEY CHẠY TRÊN PLANE RIÊNG", "originalText": "MỘT INGEST  →  ABR  →  CDN FAN-OUT;  COMMENTS VÀ MONEY CHẠY TRÊN PLANE RIÊNG",
