      "text": "LIVESTREAM PLATFORM — 2,1 TRIỆU VIEWERS", "originalText": "LIVESTREAM PLATFORM — 2,1 TRIỆU VIEWERS",
      "fontSize": 52, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 100001, "version": 1, "versionNonce": 100101, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "header_subtitle", "x": 105, "y": 120, "width": 2500, "height": 35,
      "text": "Reference architecture — không phải thiết kế nội bộ chính thức của TikTok", "originalText": "Reference architecture — không phải thiết kế nội bộ chính thức của TikTok",
      "fontSize": 22, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
