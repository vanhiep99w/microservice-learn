      "text": "POST /gifts\nIdempotency-Key: gift_user401_room9821_0007\n\n{\n  \"eventType\": \"gift.accepted.v1\",\n  \"eventId\": \"evt_01J...\",\n  \"giftOrderId\": \"gift_771\",\n  \"transactionId\": \"txn_8891\",\n  \"roomId\": \"room_9821\"\n}", "originalText": "POST /gifts\nIdempotency-Key: gift_user401_room9821_0007\n\n{\n  \"eventType\": \"gift.accepted.v1\",\n  \"eventId\": \"evt_01J...\",\n  \"giftOrderId\": \"gift_771\",\n  \"transactionId\": \"txn_8891\",\n  \"roomId\": \"room_9821\"\n}",
