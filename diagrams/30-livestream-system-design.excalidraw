    },
    {
      "type": "text", "id": "capacity_text", "x": 3380, "y": 108, "width": 1030, "height": 190,
      "text": "N = 2.100.000 viewers\nR = 2 Mb/s average delivered bitrate\nEgress = N × R = 4,2 Tbps\n1 giờ peak ≈ 1,89 PB\n2s segments ≈ 1,05M req/s @ CDN edge", "originalText": "N = 2.100.000 viewers\nR = 2 Mb/s average delivered bitrate\nEgress = N × R = 4,2 Tbps\n1 giờ peak ≈ 1,89 PB\n2s segments ≈ 1,05M req/s @ CDN edge",
      "fontSize": 23, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 100006, "version": 1, "versionNonce": 100106, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35
    },
